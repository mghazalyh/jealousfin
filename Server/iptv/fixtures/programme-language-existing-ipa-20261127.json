                  "children": [
                    {
                      "height": 80,
                      "html": "<style>body{padding:3px 1px;color:#bfc0b8;background:transparent}.sources{display:flex;gap:8px}.sources button{flex:1;min-height:42px;border:1px solid #393b3b;color:#bfc0b8;background:#1b1d1e;border-radius:9px;font-weight:600}.sources button.active{background:#27332e;border-color:#53675b;color:#c1c9bb}.sources button:disabled{opacity:.5}.sources button:active{background:#343935}#msg{font-size:12px;text-align:center;padding-top:5px;color:#999e96;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}</style><div class=\"sources\"><button id=\"american\" onclick=\"selectSource('american')\">English</button><button id=\"malay\" onclick=\"selectSource('malay')\">Malay</button></div><div id=\"msg\">Source selector</div><script>\nlet busy=false,serial=0,waiters={};const el=id=>document.getElementById(id);\nfunction paint(){let s=window.jealousfinState||{},p=s.preferences||{},a=p.surfCategory==='Movies & Series'?'malay':'american';for(let name of ['american','malay']){el(name).classList.toggle('active',a===name);el(name).disabled=busy;}if(!busy)el('msg').textContent=(a==='malay'?'Malay':'English')+' · '+(s.channels??'—')+' channels';}\nwindow.addEventListener('jealousfin-state',paint);\nwindow.addEventListener('jealousfin-receipt',e=>{let d=e.detail,w=waiters[d.requestID];if(w){delete waiters[d.requestID];clearTimeout(w.timer);d.status==='succeeded'?w.resolve(d):w.reject(Error(d.result||d.status));}});\nfunction call(command,args){return new Promise((resolve,reject)=>{let id='source-'+Date.now()+'-'+(++serial);let timer=setTimeout(()=>{delete waiters[id];reject(Error('Command timed out: '+command));},120000);waiters[id]={resolve,reject,timer};window.jealousfin.command(command,args||{},id);});}\nasync function selectSource(name){if(busy)return;let s=window.jealousfinState||{},p=s.preferences||{},old=p.surfCategory||'All Channels',target=name==='malay'?'Movies & Series':'All Channels';busy=true;paint();el('msg').textContent='Loading '+(name==='american'?'English':'Malay')+'…';try{if(old===target&&s.surfing&&s.channels){if(s.surfPaused)await call('resume_surf');}else{if(s.surfing&&!s.surfPaused)await call('pause_surf');await call('stop');await call('set_preferences',{surfCategory:target});await call('refresh_catalogue');await call('start_surf',{category:target});}el('msg').textContent='Loaded '+(name==='american'?'English':'Malay');}catch(e){el('msg').textContent='Switch failed: '+String(e.message).slice(0,140);try{await call('stop');await call('set_preferences',{surfCategory:old});await call('refresh_catalogue');}catch(_){} }finally{busy=false;for(let name of ['american','malay'])el(name).disabled=false;}}\npaint();</script>",
                      "id": "prototype-source-switcher",
